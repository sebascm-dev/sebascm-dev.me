# Copy this to .env.local and fill in the values.

# PostgreSQL connection string (self-hosted Supabase).
# Local development goes through the SSH tunnel (ssh -N supabase-tunnel):
#   postgresql://postgres:PASSWORD@localhost:5433/postgres
# In production, use the internal Docker hostname of the database container:
#   postgresql://postgres:PASSWORD@supabase-db-<id>:5432/postgres
DATABASE_URL=

# Supabase Auth (self-hosted). Server-only: do not prefix with NEXT_PUBLIC_.
# The anon key is public by design; RLS and ADMIN_EMAIL protect the data.
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=

# The only account allowed into /admin. Create it in Supabase Studio:
# Authentication → Users → Add user, with "Auto Confirm User" checked.
ADMIN_EMAIL=admin@example.com
