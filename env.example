# Copy this to .env.local and fill in the values.

# PostgreSQL connection string (self-hosted Supabase).
# Local development goes through an SSH tunnel, so the host is localhost:
#   postgresql://postgres:PASSWORD@localhost:5432/postgres
# In production, use the internal Docker hostname of the database container.
DATABASE_URL=

# Auth.js v5 — required for the admin panel

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# Admin credentials
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password (rounds=12)
# Generate: node -e "const b=require('bcryptjs');b.hash('your-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=
